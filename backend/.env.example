# Required
MONGODB_URI=mongodb://localhost:27017/plagiarism-detector
LLM_API_KEY=your-llm-api-key
LLM_MODEL=your-model-name
LLM_BASE_URL=https://api.openai.com/v1
# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Teachers must enter this code to create a teacher account.
# If unset: teacher sign-up is open in development and DISABLED in production.
TEACHER_SIGNUP_CODE=

# Optional (defaults shown)
PORT=5000
CLIENT_URL=http://localhost:5173
MAX_FILE_SIZE_MB=10
MAX_ANALYSIS_CHARACTERS=100000
NODE_ENV=development
LLM_TIMEOUT_MS=90000
JWT_EXPIRES_IN=7d
RATE_LIMIT_MAX=100
ANALYSIS_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_MAX=20
SIGNUP_RATE_LIMIT_MAX=30

# Teacher account (created/synced automatically on startup)
TEACHER_NAME=Teacher Name
TEACHER_EMAIL=teacher@example.com
TEACHER_PASSWORD=
